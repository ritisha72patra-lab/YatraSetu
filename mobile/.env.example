# Only needed for a PHYSICAL PHONE on the same Wi-Fi as your PC.
# Leave commented out for web (browser) or emulator/simulator testing —
# the app already picks the right default for those automatically
# (localhost for web/iOS simulator, 10.0.2.2 for Android emulator).
# EXPO_PUBLIC_API_URL=http://<your-PC-LAN-IP>:4000

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID >
# Web application. Add authorized redirect URI:
#   https://auth.expo.io/@<your-expo-username>/panthan
# See root README.md "Firebase Google Sign-In setup" for the full walkthrough.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
