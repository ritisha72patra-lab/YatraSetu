PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
CLIENT_ORIGIN="http://localhost:4000"
OPENWEATHER_API_KEY="replace-with-openweather-key"
WAQI_API_TOKEN="replace-with-waqi-token"
GEMINI_API_KEY="replace-with-gemini-key"
GEMINI_MODEL="gemini-1.5-flash"
PREDICTION_SERVICE_URL="http://localhost:8001"
# Signed QR cards (any random string; defaults to JWT_SECRET if empty)
QR_SECRET="replace-with-a-long-random-secret-2"
QR_TTL_DAYS="730"
# Payments: leave empty for mock checkout (no real money). Set both for Razorpay live/test orders.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional live hotel rates (leave empty to use curated seed prices — works on any system).
# Amadeus Hotel Search free test tier: https://developers.amadeus.com
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
# Optional live hotel inventory via RapidAPI Booking18/Agoda (paid).
RAPIDAPI_HOTEL_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Public Firebase *web* config for Google popup + phone OTP in the browser.
# Firebase console > Project settings > Your apps > Web app > copy the config object, paste as one line.
# Example: {"apiKey":"AIza...","authDomain":"yatrasetu-53362.firebaseapp.com","projectId":"yatrasetu-53362","appId":"1:...:web:..."}
FIREBASE_WEB_CONFIG_JSON=
OPENROUTESERVICE_API_KEY="your-key"
