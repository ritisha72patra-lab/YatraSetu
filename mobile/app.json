{
  "expo": {
    "name": "Panthan",
    "slug": "panthan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/panthan-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "panthan",
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "in.panthan.app" },
    "android": { "package": "in.panthan.app", "adaptiveIcon": { "foregroundImage": "./assets/panthan-icon.png", "backgroundColor": "#eef4f4" } },
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow Panthan to scan guide/cab QR codes." }],
      ["expo-location", { "locationWhenInUsePermission": "Allow Panthan to show your live location next to your guide for safety." }],
      ["expo-splash-screen", { "image": "./assets/panthan-icon.png", "resizeMode": "contain", "backgroundColor": "#eef4f4" }]
    ],
    "extra": {
      "apiUrl": "http://172.29.163.91:4000",
      "eas": { "projectId": "00000000-0000-0000-0000-000000000000" }
    }
  }
}
