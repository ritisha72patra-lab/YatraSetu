PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
CLIENT_ORIGIN="http://localhost:4000"
OPENWEATHER_API_KEY="replace-with-openweather-key"
WAQI_API_TOKEN="replace-with-waqi-token"
PREDICTION_SERVICE_URL="http://localhost:8001"
# Firebase Admin SDK (server-side, verifies ID tokens). Firebase Console >
# Project settings > Service accounts > Generate new private key. Paste the
# ENTIRE downloaded JSON file as a single-line string here.
FIREBASE_SERVICE_ACCOUNT_JSON='PASTE_SERVICE_ACCOUNT_JSON_HERE'
OPENROUTESERVICE_API_KEY="your-key"
